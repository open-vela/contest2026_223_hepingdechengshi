{"schema_version": "1.0", "session_id": "42b9fb43-99d0-48a1-bb9b-f0ae0d506614", "team_id": "contest2026_223_hepingdechengshi", "github_login": "lthxxn", "tool": "claude-code", "seq": 209, "ts": "2026-09-19T16:33:03.195Z", "role": "tool", "tool_name": "<result>", "tool_call_id": "tooluse_MYdgSpSkGz2dlBYTzzeVXZ", "input": null, "output": "1\t#include <stdint.h>\n2\t\n3\t#include <assert.h>\n4\t\n5\t#include \"smp.h\"\n6\t#include \"sys_driver.h\"\n7\t#include <driver/mailbox.h>\n8\t#include <nuttx/arch.h>\n9\t#include <nuttx/config.h>\n10\t#include <nuttx/sched.h>\n11\t#include <syslog.h>\n12\t#include \"cmsis_gcc.h\"\n13\t#include \"easy_log.h\"\n14\t#include \"beken_arch.h\"\n15\t#include \"beken_irq.h\"\n16\t/* nxsched_process_delivered is declared in the internal sched/sched.h;\n17\t * forward-declare it here to avoid pulling in private kernel headers. */\n18\tvoid nxsched_process_delivered(int cpu);\n19\t\n20\t/* nx_idle_trampoline is the NuttX secondary CPU entry point.\n21\t * Forward-declare to avoid pulling in init/init.h. */\n22\tvoid nx_idle_trampoline(void);\n23\t\n24\t/* bk_mailbox_master_send is defined in mbox0_cross_core.c but has no\n25\t * public header declaration — forward-declare it here. */\n26\tbk_err_t bk_mailbox_master_send(mailbox_data_t *data, uint8_t src, uint8_t dst);\n27\t\n28\t/* reset_cpu1_core is defined in bk_startup/system_main.c — releases\n29\t * physical AP CPU1 from reset after programming its boot vector address. */\n30\tvoid reset_cpu1_core(uint32_t offset, uint32_t start_flag);\n31\t\n32\t/* Beken per-CPU startup: multicore_cpu1_func is set by the primary core\n33\t * before releasing CPU1 from reset.  CPU1's Reset_Handler_Cpu1 calls\n34\t * _othercore_start() which invokes this function pointer to enter the OS.\n35\t * Defined in startup_cpu1.c. */\n36\textern void (*multicore_cpu1_func)(void);\n37\t\n38\t/* CPU1 vector table base address, defined by the linker script\n39\t * (bk7258_ap_bsp.ld) at a 512-byte aligned offset in the .vectors section. */\n40\textern uint32_t __vector_core1_table;\n41\t\n42\textern uint32_t __StackTopCpu0;\n43\textern uint32_t __StackLimitCpu0;\n44\t\n45\textern uint32_t __StackTopCpu1;\n46\textern uint32_t __StackLimitCpu1;\n47\t\n48\t#define NUTTX_STACK_SIZE (4 << 10);\n49\t\n50\t/* Idle stack pool exported by the linker script.\n51\t * Total size: CONFIG_SMP_NCPUS * CONFIG_IDLETHREAD_STACKSIZE.\n52\t * CPU n's stack_alloc = g_cpu_stackalloc + CONFIG_IDLETHREAD_STACKSIZE * (n +\n53\t * 1). */\n54\textern uint8_t g_cpu_stackalloc[];\n55\t\n56\tint up_cpu_index(void) { return nuttx_cpu_get_core_id(); }\n57\t\n58\t/****************************************************************************\n59\t * Name: up_cpu_start\n60\t *\n61\t * Description:\n62\t *   In an SMP configuration, the primary CPU (CPU0) calls this function to\n63\t *   start a secondary CPU.  Only CPU 1 is started here (CPU 0 is already\n64\t *   active).\n65\t *\n66\t *   The secondary CPU (physical CPU1) boots through its own reset handler\n67\t *   (Reset_Handler_Cpu1), which calls _othercore_start().  That function\n68\t *   reads the global function pointer 'multicore_cpu1_func' and invokes\n69\t *   it to enter the OS.  We set that pointer to NuttX's nx_idle_trampoline\n70\t *   and then release CPU1 from reset via the Beken HAL.\n71\t *\n72\t * Input Parameters:\n73\t *   cpu - The index of the CPU being started (1 for the secondary core).\n74\t *\n75\t * Returned Value:\n76\t *   Zero on success; a negated errno value on failure.\n77\t *\n78\t ****************************************************************************/\n79\tstatic volatile bool g_trace_core2_debug = true;\n80\tstatic void multicore_start_debug_func(void) {\n81\t  common_irq_initialize_on_core();\n82\t  __enable_fault_irq();\n83\t  __enable_irq();\n84\t  EA_LOG_D(\"multicore start function\");\n85\t  \n86\t  nx_idle_trampoline();\n87\t}\n88\textern void reset_cpu2_core(uint32 offset, uint32_t start_flag);\n89\tint up_cpu_start(int cpu)\n90\t{\n91\t  /* Only CPU 1 can be started (CPU 0 is already running). */\n92\t  if (cpu != 1)\n93\t    {\n94\t      return -EINVAL;\n95\t    }\n96\t\n97\t  /* Set the entry point that Reset_Handler_Cpu1 → _othercore_start()\n98\t   * will call once AP CPU1 comes out of reset.\n99\t   */\n100\t  multicore_cpu1_func = multicore_start_debug_func;\n101\t\n102\t  /* Boot AP CPU1: reset_cpu1_core() programs the boot vector address\n103\t   * (__vector_core1_table) and releases the reset, causing CPU1 to\n104\t   * execute Reset_Handler_Cpu1 → _othercore_start() → our callback.\n105\t   *\n106\t   * Defined in vendor/beken/chips/component/bk_startup/system_main.c.\n107\t   */\n108\t  reset_cpu2_core((uint32_t)&__vector_core1_table, 1);\n109\t\n110\t  return 0;\n111\t}\n112\t/* -------------------------------------------------------------------------\n113\t * SMP inter-core notification via BK7258 cross-core mailbox (mbox0).\n114\t *\n115\t * This uses bk_mailbox_master_send / crosscore_mb_rx_isr -- the same\n116\t * low-level mbox0 path used by the FreeRTOS SMP port -- which is\n117\t * completely separate from the higher-level bk_mailbox_send channel\n118\t * layer.  No conflict with mailbox_channel.c's registrations.\n119\t *\n120\t * up_cpu_index() returns a 0-based logical index (0 or 1).  The mbox0\n121\t * driver uses physical CPU IDs, so all conversions use:\n122\t *   physical_id = logical_cpu + MAILBOX_CPU1   (AP = physical CPU1/CPU2)\n123\t *\n124\t * bk_mailbox_cc_init_on_current_core() is already called from\n125\t * startup_cpu1.c / startup_cpu2.c before the scheduler starts; it\n126\t * registers crosscore_smp_cmd_handler as the mbox0 receive callback,\n127\t * which in turn calls crosscore_mb_rx_isr() below.\n128\t * No separate init step is needed in beken_arch.c.\n129\t * ------------------------------------------------------------------------- */\n130\t\n131\t/* Convert a NuttX logical CPU index (0-based) to a physical CPU ID. */\n132\t#define LOGICAL_TO_PHYS(n) ((uint8_t)((n) + MAILBOX_CPU1))\n133\t\n134\t/* Command identifiers (stored in mailbox_data_t.param2, matching the\n135\t * layout expected by bk_mailbox_master_send / crosscore_smp_cmd_handler). */\n136\t\n137\t/**\n138\t * crosscore_mb_rx_isr - mbox0 receive handler for NuttX SMP.\n139\t *\n140\t * Called by crosscore_smp_cmd_handler (mbox0_cross_core.c) whenever\n141\t * another core sends a message.  Replaces the FreeRTOS version.\n142\t *\n143\t * param0 = physical source CPU ID\n144\t * param2 = command (BK_NUTTX_SMP_CMD_SCHED or BK_NUTTX_SMP_CMD_CALL)\n145\t */\n146\tvoid crosscore_mb_rx_isr(mailbox_data_t *data) {\n147\t  uint32_t cmd = data->param2;\n148\t  syslog(LOG_INFO, \"crosscore_mb_rx_isr[%d]:%d \\r\\n\", up_cpu_index(), (int)cmd);\n149\t  if (cmd == BK_NUTTX_SMP_CMD_SCHED || cmd == BK_NUTTX_SMP_CMD_CALL) {\n150\t    /* Process pending cross-core function calls, then deliver tasks.\n151\t     * If either queue is empty, the handler is a cheap no-op. */\n152\t    nxsched_smp_call_handler(0, NULL, NULL);\n153\t    nxsched_process_delivered(up_cpu_index());\n154\t  }\n155\t}\n156\t\n157\tint up_send_smp_sched(int cpu) {\n158\t  int from = up_cpu_index();\n159\t  mailbox_data_t data;\n160\t\n161\t  data.param0 = (uint32_t)LOGICAL_TO_PHYS(from); /* source physical ID */\n162\t  data.param1 = (uint32_t)LOGICAL_TO_PHYS(cpu);  /* dest physical ID   */\n163\t  data.param2 = BK_NUTTX_SMP_CMD_SCHED;\n164\t  data.param3 = 0;\n165\t\n166\t  bk_mailbox_master_send(&data, LOGICAL_TO_PHYS(from), LOGICAL_TO_PHYS(cpu));\n167\t  return OK;\n168\t}\n169\t\n170\tvoid up_send_smp_call(cpu_set_t cpuset) {\n171\t  int from = up_cpu_index();\n172\t  int cpu;\n173\t  mailbox_data_t data;\n174\t\n175\t  /* Send one mbox0 message per target CPU; skip self (already handled). */\n176\t  while (cpuset != 0) {\n177\t    cpu = ffs((int)cpuset) - 1;\n178\t    cpuset &= ~((cpu_set_t)1 << cpu);\n179\t\n180\t    if (cpu == from) {\n181\t      continue;\n182\t    }\n183\t\n184\t    data.param0 = (uint32_t)LOGICAL_TO_PHYS(from);\n185\t    data.param1 = (uint32_t)LOGICAL_TO_PHYS(cpu);\n186\t    data.param2 = BK_NUTTX_SMP_CMD_CALL;\n187\t    data.param3 = 0;\n188\t\n189\t    bk_mailbox_master_send(&data, LOGICAL_TO_PHYS(from), LOGICAL_TO_PHYS(cpu));\n190\t  }\n191\t}\n192\tint bk_cross_core_send(uint32_t cmd) {\n193\t  syslog(LOG_INFO, \"bk_cross_core_send %d\", cmd);\n194\t  int from = up_cpu_index();\n195\t  mailbox_data_t data;\n196\t\n197\t  data.param0 = (uint32_t)LOGICAL_TO_PHYS(from); /* source physical ID */\n198\t  data.param1 = (uint32_t)LOGICAL_TO_PHYS(1 - from);  /* dest physical ID   */\n199\t  data.param2 = cmd;\n200\t  data.param3 = 0;\n201\t\n202\t  bk_mailbox_master_send(&data, LOGICAL_TO_PHYS(from), LOGICAL_TO_PHYS(1 - from));\n203\t  return OK;\n204\t}\n205\tuintptr_t up_get_intstackbase(int cpu) {\n206\t  uintptr_t ret = 0;\n207\t  if (cpu == 0) {\n208\t    ret = (uintptr_t)&__StackLimitCpu0;\n209\t  } else if (cpu == 1) {\n210\t    ret = (uintptr_t)&__StackLimitCpu1;\n211\t  }\n212\t  return ret;\n213\t}\n214\tint up_cpu_idlestack(int cpu, struct tcb_s *tcb, size_t stack_size) {\n215\t  uintptr_t stack_alloc;\n216\t\n217\t  DEBUGASSERT(cpu >= 0 && cpu < CONFIG_NCPUS && tcb != NULL);\n218\t\n219\t  /* Each CPU gets a dedicated slot in the g_cpu_stackalloc pool.\n220\t   * CPU n occupies [n*SIZE, (n+1)*SIZE), so stack_alloc points to\n221\t   * the top of that slot: g_cpu_stackalloc + (n + 1) * SIZE. */\n222\t\n223\t  stack_alloc =\n224\t      (uintptr_t)g_cpu_stackalloc + CONFIG_IDLETHREAD_STACKSIZE * (cpu);\n225\t\n226\t  DEBUGASSERT((stack_alloc & STACKFRAME_ALIGN_MASK) == 0);\n227\t\n228\t  tcb->adj_stack_size = stack_size;\n229\t  tcb->stack_alloc_ptr = (void *)stack_alloc;\n230\t  tcb->stack_base_ptr = tcb->stack_alloc_ptr;\n231\t\n232\t  return OK;\n233\t}\n234\t", "is_error": false}
