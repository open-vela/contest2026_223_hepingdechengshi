Description:\n1357\t *   Release all bit on a non-reentrant spinlock.\n1358\t *\n1359\t * Input Parameters:\n1360\t *   lock - A reference to the spinlock object to unlock.\n1361\t *\n1362\t * Returned Value:\n1363\t *   None.\n1364\t *\n1365\t * Assumptions:\n1366\t *   Not running at the interrupt level.\n1367\t *\n1368\t ****************************************************************************/\n1369\t\n1370\tstatic inline_function void write_unlock(FAR volatile rwlock_t *lock)\n1371\t{\n1372\t  /* Ensure this cpu already get write lock */\n1373\t\n1374\t  DEBUGASSERT(atomic_read(&lock->lock) == RW_SP_WRITE_LOCKED);\n1375\t\n1376\t  spinlock_mark_unlocked(&lock->info);\n1377\t  atomic_set_release(&lock->lock, RW_SP_UNLOCKED);\n1378\t}\n1379\t\n1380\t/****************************************************************************\n1381\t * Name: read_lock_irqsave\n1382\t *\n1383\t * Description:\n1384\t *   If SMP is enabled:\n1385\t *     The argument lock should be specified,\n1386\t *     disable local interrupts and take the lock spinlock and return\n1387\t *     the interrupt state.\n1388\t *\n1389\t *     NOTE: This API is very simple to protect data (e.g. H/W register\n1390\t *     or internal data structure) in SMP mode. Do not use this API\n1391\t *     with kernel APIs which suspend a caller thread. (e.g. nxsem_wait)\n1392\t *\n1393\t *   If SMP is not enabled:\n1394\t *     This function is equivalent to up_irq_save().\n1395\t *\n1396\t * Input Parameters:\n1397\t *   lock - Caller specific spinlock, not NULL.\n1398\t *\n1399\t * Returned Value:\n1400\t *   An opaque, architecture-specific value that represents the state of\n1401\t *   the interrupts prior to the call to write_lock_irqsave(lock);\n1402\t *\n1403\t ****************************************************************************/\n1404\t\n1405\t#ifdef CONFIG_SPINLOCK\n1406\tirqstate_t read_lock_irqsave(FAR rwlock_t *lock);\n1407\t#else\n1408\t#  define read_lock_irqsave(l) ((void)(l), up_irq_