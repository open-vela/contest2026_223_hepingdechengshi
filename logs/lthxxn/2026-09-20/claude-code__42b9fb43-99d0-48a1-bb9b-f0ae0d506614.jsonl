ed.h\"\n42\t\n43\t/****************************************************************************\n44\t * Public Functions\n45\t ****************************************************************************/\n46\t\n47\t/****************************************************************************\n48\t * Name: nxtask_activate\n49\t *\n50\t * Description:\n51\t *   This function activates tasks initialized by nxtask_setup_scheduler().\n52\t *   Without activation, a task is ineligible for execution by the\n53\t *   scheduler.\n54\t *\n55\t * Input Parameters:\n56\t *   tcb - The TCB for the task for the task (same as the nxtask_init\n57\t *         argument).\n58\t *\n59\t * Returned Value:\n60\t *   None\n61\t *\n62\t ****************************************************************************/\n63\t\n64\tvoid nxtask_activate(FAR struct tcb_s *tcb)\n65\t{\n66\t  irqstate_t flags = enter_critical_section();\n67\t  FAR struct tcb_s *rtcb = this_task();\n68\t\n69\t#ifdef CONFIG_SCHED_INSTRUMENTATION\n70\t\n71\t  /* Check if this is really a re-start */\n72\t\n73\t  if (tcb->task_state != TSTATE_TASK_INACTIVE)\n74\t    {\n75\t      /* Inform the instrumentation layer that the task\n76\t       * has stopped\n77\t       */\n78\t\n79\t      sched_note_stop(tcb);\n80\t    }\n81\t\n82\t  /* Inform the instrumentation layer that the task\n83\t   * has started\n84\t   */\n85\t\n86\t  sched_note_start(tcb);\n87\t#endif\n88\t\n89\t#ifdef CONFIG_SCHED_PERF_EVENTS\n90\t  perf_event_task_init(tcb);\n91\t#endif\n92\t\n93\t  /* Remove the task from waitting list */\n94\t\n95\t  nxsched_remove_blocked(tcb);\n96\t\n97\t  sinfo(\"%s pid=%d,TCB=%p\\n\", get_task_name(tcb),\n98\t        tcb->pid, tcb);\n99\t\n100\t  /* Add the task to ready-to-run task list, and\n101\t   * perform the context switch if one is needed\n102\t   */\n103\t\n104\t  if (nxsched_add_readytorun(tcb))\n105\t    {\n106\t      nxsched_switch(this_task(), rtcb);\n107\t    }\n108\t\n109\t  leave_critical_section(flags);\n110\t}\n111\t", "is_error": false}
