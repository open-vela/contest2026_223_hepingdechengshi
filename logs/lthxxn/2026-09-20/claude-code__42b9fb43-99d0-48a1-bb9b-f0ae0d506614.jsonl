_irq.c\n35\t    ${BEKEN_CHIP_DIR}/src/beken_uart.c\n36\t    ${BEKEN_CHIP_DIR}/src/beken_timer.c\n37\t    ${BEKEN_CHIP_DIR}/src/beken_arch.c\n38\t    ${BEKEN_CHIP_DIR}/src/beken_bringup.c\n39\t    ${BEKEN_CHIP_DIR}/src/beken_rtos.c\n40\t    ${BEKEN_CHIP_DIR}/src/beken_port.c\n41\t)\n42\tset(ENV{PYTHONPATH} $ENV{PYTHONPATH}:${BEKEN_CHIPS_DIR}/tools/env_tools/bk_py_libs)\n43\t\n44\tmessage(\"Python:\" $ENV{PYTHONPATH})\n45\t\n46\t# Helper for running bk_sdk python tools with the required environment injected.\n47\tinclude(${BEKEN_CHIPS_DIR}/cmake/bk_python.cmake)\n48\t\n49\t# Derive the Beken SoC name string from the Kconfig boolean.  Must be set\n50\t# BEFORE add_subdirectory() so shared subdirectories see the selected SDK\n51\t# environment when they add generated-file dependencies.\n52\t# see it when they call bk_add_python_command().\n53\tif(CONFIG_ARCH_CHIP_BK7258)\n54\t    set(BEKEN_SOC_NAME \"bk7258\")\n55\telse()\n56\t    # Extend this block when additional BK SoC variants are added.\n57\t    set(BEKEN_SOC_NAME \"unknown\")\n58\tendif()\n59\t\n60\ttarget_sources(arch PRIVATE ${SRCS})\n61\ttarget_include_directories(arch PRIVATE\n62\t    ${BEKEN_CHIP_DIR}/include\n63\t    ${BEKEN_CHIP_DIR}/src\n64\t    ${BEKEN_CHIPS_DIR}/drivers/include\n65\t    # Board dir so common chip headers can resolve \"partitions/partitions.h\"\n66\t    # (e.g. driver/flash_partition.h) after the board config was moved out to\n67\t    # vendor/beken/boards/<soc>_ap.\n68\t    ${BEKEN_CHIPS_DIR}/../boards/${BEKEN_SOC_NAME}_ap\n69\t)\n70\tadd_subdirectory(${BEKEN_CHIPS_DIR}/common ${CMAKE_CURRENT_BINARY_DIR}/common)\n71\tadd_subdirectory(${BEKEN_CHIPS_DIR}/drivers ${CMAKE_CURRENT_BINARY_DIR}/drivers)\n72\tadd_subdirectory(${BEKEN_CHIPS_DIR}/soc ${CMAKE_CURRENT_BINARY_DIR}/soc_common)\n73\tadd_subdirectory(${BEKEN_CHIP_DIR}/soc ${CMAKE_CURRENT_BINARY_DIR}/soc)\n74\tadd_subdirectory(${BEKEN_CHIPS_DIR}/component ${CMAKE_CURRENT_BINARY_DIR}/component)\n75\t\n76\t# Initialise the bk_sdk environment variables that bk_curr_project.py\n77\t# reads via os.getenv().  These variables are not set in the NuttX build\n78\t# environment, so environment.py accepts them as explicit CLI arguments and\n79\t# writes them into the process environment for any child it spawns.\n80\t# Both outputs (JSON for inspection, shell script for sourcing) are declared\n81\t# so that downstream custom commands can list them in their DEPENDS.\n82\tset(PYENV_SCRIPT ${BEKEN_CHIPS_DIR}/tools/environment.py)\n83\tset(ENVIRONMENT_JSON ${CMAKE_BINARY_DIR}/env/env.json)\n84\tset(ENVIRONMENT_SH   ${CMAKE_BINARY_DIR}/env/env_setup.sh)\n85\t\n86\tmessage(\"ENVIRONMENT_JSON:\" ${ENVIRONMENT_JSON})\n87\t# Ensure the output directory exists before the custom command runs.\n88\tfile(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/env)\n89\tadd_custom_command(OUTPUT ${ENVIRONMENT_JSON} ${ENVIRONMENT_SH}\n90\t    COMMAND ${Python3_EXECUTABLE} ${PYENV_SCRIPT}\n91\t        --project-dir  \"${BEKEN_CHIPS_DIR}/app\"\n92\t        --custom-project-dir  \"${BEKEN_CHIPS_DIR}/..\"\n93\t        --build-dir    \"${CMAKE_BINARY_DIR}\"\n94\t        --soc-name     \"${BEKEN_SOC_NAME}\"\n95\t        --project-name \"${NUTTX_CONFIG}\"\n96\t        --output       \"${ENVIRONMENT_JSON}\"\n97\t        --export-sh    \"${ENVIRONMENT_SH}\"\n98\t    DEPENDS ${CONFIG_FILE_LISTS} ${PYENV_SCRIPT}\n99\t)\n100\tadd_custom_target(environment_setup_helper DEPENDS ${ENVIRONMENT_JSON})\n101\tadd_dependencies(arch environment_setup_helper)\n102\t\n103\t# set_source_files_properties(DIRECTORY component common soc\n104\t# \tTARGET_DIRECTORY arch\n105\t# \tPROPERTIES COMPILE_OPTIONS \"-Wno-undef;-Wno-strict-prototypes\")\n106\tadd_compile_options(\"-Wno-undef\")\n107\tadd_compile_options(\"-Wno-strict-prototypes\")\n108\t\n109\tset(project_elf_src ${CMAKE_BINARY_DIR}/project_elf_src.c)\n110\t\n111\t# Generate at configure time so CMake can find the file when validating sources.\n112\t# (set_source_files_properties + GENERATED does not work reliably here because\n113\t# this directory is pulled in via add_subdirectory(... EXCLUDE_FROM_ALL).)\n114\tfile(WRITE ${project_elf_src}\n115\t     \"volatile const char build_version[] = __DATE__ \\\" \\\" __TIME__;\\n\")\n116\t\n117\t# Build-time rule: regenerates the file on every build, capturing the current\n118\t# compilation timestamp via __DATE__ / __TIME__ preprocessor macros.\n119\tadd_custom_command(OUTPUT ${project_elf_src}\n120\t    COMMAND sh -c \"echo 'volatile const char build_version[] = __DATE__ \\\" \\\" __TIME__;' > ${project_elf_src}\"\n121\t    COMMENT \"armino ====> gen file ${project_elf_src}...\"\n122\t    VERBATIM)\n123\tadd_custom_target(_project_elf_src DEPENDS \"${project_elf_src}\")\n124\tadd_dependencies(arch _project_elf_src)\n125\ttarget_sources(arch PRIVATE ${project_elf_src})\n126\t\n127\t\n128\t\n129\t\n130\t\n131\t\n132\tset(BK_PACKAGE_TOOL ${BEKEN_CHIPS_DIR}/tools/build_tools/build_process/bk_build_package.py)\n133\tset(BK_ALL_PACKAGE ${CMAKE_BINARY_DIR}/package/all-app.bin)\n134\t\n135\tbk_add_python_command(\n136\t\tOUTPUT  ${BK_ALL_PACKAGE}\n137\t\tSCRIPT  ${BK_PACKAGE_TOOL}\n138\t\tARGS    bk7258_ap\n139\t\tDEPENDS ${CONFIG_FILE_LISTS}\n140\t\t        \"${CMAKE_BINARY_DIR}/bk7258/app.bin\"\n141\t\t        \"${CMAKE_BINARY_DIR}/bk7258_ap/app.bin\"\n142\t\tCOMMENT \"Generating Post\"\n143\t)\n144\tadd_custom_target(bk_package DEPENDS \"${BK_ALL_PACKAGE}\")\n145\t\n146\t\n147\tset(AUTO_PARTITION_TABLE ${BEKEN_CHIPS_DIR}/app/partitions/bk7258/auto_partitions.csv)\n148\tset(PARTITIONS_DIR  ${CMAKE_BINARY_DIR}/partitions)\n149\tset(auto_partition_script ${BEKEN_CHIPS_DIR}/tools/build_tools/build_process/bk_build_auto_partition.py)\n150\tset(auto_partition_out ${PARTITIONS_DIR}/partitions.txt)\n151\t\n152\tbk_add_python_command(\n153\t\tOUTPUT  ${auto_partition_out}\n154\t\tSCRIPT  ${auto_partition_script}\n155\t\tARGS    \n156\t\tDEPENDS ${AUTO_PARTITION_TABLE}\n157\t\tCOMMENT \"Generating auto_partition_out\"\n158\t)\n159\tadd_custom_target(_auto_partition_out DEPENDS ${auto_partition_out})\n160\tadd_dependencies(arch _auto_partition_out)\n161\t\n162\tset(ram_partition_script ${BEKEN_CHIPS_DIR}/tools/build_tools/build_process/bk_build_ram_regions.py)\n163\tset(RAM_REGIONS_TABLE ${BEKEN_CHIPS_DIR}/app/partitions/bk7258/ram_regions.csv)\n164\tset(ram_regions_out ${PARTITIONS_DIR}/ram_regions.h)\n165\t\n166\t\n167\tbk_add_python_command(\n168\t\tOUTPUT  ${ram_regions_out}\n169\t\tSCRIPT  ${ram_partition_script}\n170\t\tARGS    \n171\t\tDEPENDS ${RAM_REGIONS_TABLE}\n172\t\tCOMMENT \"Generating ram_regions_out\"\n173\t)\n174\tadd_custom_target(_ram_region DEPENDS ${ram_regions_out})\n175\t\n176\tnuttx_cpp_compile_options(-I${PARTITIONS_DIR})\n177\ttarget_include_directories(arch PRIVATE ${PARTITIONS_DIR})\n178\t\n179\t# Include roots needed to preprocess the board linker script\n180\t# (boards/bk7258_ap/scripts/bk7258_ap_bsp.ld). These match the #include paths\n181\t# written relative to the moved SDK layout after the board/chip restructure:\n182\t#   \"common/include/soc/bk7258/reg_base.h\" -> ${BEKEN_CHIPS_DIR}\n183\t#   \"bk7258_ap/partitions/partitions.h\"    -> ${BEKEN_CHIPS_DIR}/../boards\n184\t#   \"cpu_id.h\"                             -> ${BEKEN_CHIP_DIR}/include\n185\tnuttx_cpp_compile_options(-I${BEKEN_CHIPS_DIR})\n186\tnuttx_cpp_compile_options(-I${BEKEN_CHIPS_DIR}/../boards)\n187\tnuttx_cpp_compile_options(-I${BEKEN_CHIP_DIR}/include)\n188\t\n189\tadd_custom_target(\n190\t    nuttx_pre_build\n191\t)\n192\t\n193\tadd_dependencies(nuttx_pre_build _auto_partition_out _ram_region)\n194\tfile(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/bk7258/)\n195\tfile(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/bk7258_ap/)\n196\t\n197\tmessage(objcopy ${CMAKE_OBJCOPY})\n198\t\n199\tadd_custom_command(OUTPUT \"${CMAKE_BINARY_DIR}/bk7258/app.bin\"\n200\t    COMMAND \"cp\" \"${BEKEN_CHIPS_DIR}/cp/components/bk_libs/bk7258/app/app.bin\" \"${CMAKE_BINARY_DIR}/bk7258/app.bin\"\n201\t    COMMENT \"Generate cp-app.bin\"\n202\t    VERBATIM\n203\t)\n204\tadd_custom_command(OUTPUT \"${CMAKE_BINARY_DIR}/bk7258_ap/app.bin\"\n205\t    COMMAND \"${CMAKE_OBJCOPY}\" -O binary ${CMAKE_BINARY_DIR}/nuttx \"${CMAKE_BINARY_DIR}/bk7258_ap/app.bin\"\n206\t    COMMENT \"Generate ap-app.bin\"\n207\t    DEPENDS ${CMAKE_BINARY_DIR}/nuttx\n208\t    VERBATIM\n209\t)\n210\t\n211\tadd_custom_target(bk_app_bin DEPENDS \"${CMAKE_BINARY_DIR}/bk7258/app.bin\" \"${CMAKE_BINARY_DIR}/bk7258_ap/app.bin\")\n212\tadd_dependencies(bk_app_bin nuttx)\n213\tadd_dependencies(bk_package bk_app_bin)\n214\tadd_custom_target(\n215\t    nuttx_post_build ALL\n216\t    DEPENDS bk_package bk_app_bin\n217\t)\n218\ttarget_compile_definitions(arch PRIVATE -DNUTTX_BUILD)\n219\ttarget_compile_options(arch PRIVATE \n220\t    $<$<COMPILE_LANGUAGE:C>:-mcpu=cortex-m33+nodsp -g>\n221\t    $<$<COMPILE_LANGUAGE:CXX>:-mcpu=cortex-m33+nodsp -g>)\n222\t", "is_error": false}
